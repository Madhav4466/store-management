<% layout("layouts/dashboard") %>
<div class="col-md-8 d-flex flex-column justify-content-center">
    <div class="row">
        <h1 class="d-flex justify-content-center">New Sale Bill</i></h1>
    </div>
    <div class="row mb-2">
        <form class="newProduct needs-validation" method="post" action="/sales" novalidate>
            <div class="row mb-2 d-flex justify-content-start">
                <div class="col-md-4">
                    <label for="invoiceNumber" class="form-label">Invoice Number</label>
                    <input id="invoiceNumber" type="text" name="invoiceNumber" class="form-control disabled read-only" value="<%= invoiceNumber %>" placeholder="Invoice Number" readonly>
                </div>
                <div class="col-md-4">
                    <label for="salesman" class="form-label">Salesman</label>
                    <select id="salesman" class="form-select" aria-label="Salesman" name="salesman" required>
                        <option selected value="<%= currentUser._id %>"><%= currentUser.firstName %> <%= currentUser.lastName %></option>
                        <% users.forEach(user => { %>
                            <% if (user._id.toString() !== currentUser._id.toString()) { %>
                                <option value="<%= user._id %>"><%= user.firstName %> <%= user.lastName %></option>
                            <% } %>
                        <% }) %>
                    </select>
                    <div class="invalid-feedback">Please Select Salesman</div>
                    <div class="valid-feedback">Looks Good!</div>
                </div>
                <div class="col-md-4">
                    <label for="invoiceDate" class="form-label">Invoice Date</label>
                    <input id="invoiceDate" type="date" name="invoiceDate" class="form-control disabled" placeholder="Invoice Date" value="<%= new Date().toISOString().split("T")[0] %>" max="<%= new Date().toISOString().split("T")[0] %>" required>
                </div>
            </div>
            <div class="row mb-2 mt-2 d-flex justify-content-start" id="customerDetails" role="group" aria-label="Customer Details">
                <div class="col-md-8 mb-1">
                    <label for="customerName" class="form-label">Customer Name *</label>
                    <input id="customerName" type="Text" name="customerName" class="form-control" placeholder="CustomerName" required>
                    <div class="invalid-feedback">Customer Name cannot be blank</div>
                    <div class="valid-feedback">Looks Good!</div>
                </div>
                <div class="col-md-4 mb-1">
                    <label for="mobile" class="form-label">Mobile</label>
                    <input id="mobile" type="text" name="mobile" class="form-control" placeholder="Mobile" maxlength="10">
                </div>
                <div class="col-md-6 mb-1">
                    <label for="email" class="form-label">Email</label>
                    <input id="email" type="email" name="email" class="form-control" placeholder="Email" autocomplete="email">
                </div>
                <div class="col-md-6 mb-1">
                    <label for="address" class="form-label">Address</label>
                    <input id="address" type="Text" name="address" class="form-control" placeholder="Address" autocomplete="address-line1">
                </div>
            </div>
            <div class="row mb-2 d-flex justify-content-start" id="paymentDetails" role="group" aria-label="Payment Details">
                <div class="col-md-6 mb-2">
                    <label for="paymentStatus" class="form-label">Payment Status</label>
                    <select id="paymentStatus" class="form-select" aria-label="Invoice Type" name="paymentStatus" required>
                        <option selected disabled>----Select Invoice Type---</option>
                        <% paymentStatuses.forEach(status => { %>
                            <option value="<%= status %>"><%= status %></option>
                        <% }) %>
                    </select>
                    <div class="invalid-feedback">Please Select Invoice Type</div>
                    <div class="valid-feedback">Looks Good!</div>
                </div>
                <div class="col-md-6 mb-2">
                    <label for="dueDate" class="form-label">Due Date</label>
                    <input id="dueDate" type="date" name="dueDate" class="form-control" placeholder="Due Date" min=<%= new Date().toISOString().split("T")[0] %> required>
                    <div class="invalid-feedback">Due Date cannot be blank</div>
                    <div class="valid-feedback">Looks Good!</div>
                </div>
                <div class="col-md-6 mb-2">
                    <label for="paymentMode" class="form-label">Payment Method</label>
                    <select id="paymentMode" class="form-select" aria-label="Payment Mode" name="paymentMode" required>
                        <option selected disabled>----Select Payment Mode---</option>
                        <% paymentMethods.forEach(method => { %>
                            <option value="<%= method %>"><%= method %></option>
                        <% }) %>
                    </select>
                    <div class="invalid-feedback">Please Select Payment Mode</div>
                    <div class="valid-feedback">Looks Good!</div>
                </div>
                <div class="col-md-6">
                    <label for="balance" class="form-label">Balance</label>
                    <input id="balance" type="Text" name="balance" class="form-control disabled" placeholder="Balance" readonly>
                </div>
            </div>
            <div class="row mb-1 mt-4 d-flex justify-content-start">
                <div class="col-md-12 mb-2">
                    <label for="selectProduct" class="form-label">Select Product</label>
                    <input id="selectProduct" type="text" class="form-control" placeholder="Type to search product" required>
                    <div id="product-listbox" class="autocomplete-products"></div>
                    <div class="invalid-feedback">Please Select Product</div>
                    <div class="valid-feedback">Looks Good!</div>
                </div>
            </div>
            <div class="row mb-1 mt-2 d-flex justify-content-start">
                <div class="col-md-12 p-3 rounded border">
                    <table class="table table-hover border m-0 m-auto items-table">
                        <thead>
                            <tr>
                              <th scope="col" class="text-center align-middle">#</th>
                              <th scope="col" class="text-center align-middle" style="width: 200px">Product Name</th>
                              <th scope="col" class="text-center align-middle">Qty</th>
                              <th scope="col" class="text-center align-middle">Rate</th>
                              <th scope="col" class="text-center align-middle">Amount</th>
                              <th scope="col" class="text-center align-middle">Actions</th>
                            </tr>
                          </thead>
                          <tbody id="productGrid">
                          </tbody>
                    </table>
                </div>
            </div>
            <div class="row mt-3 d-flex">
                <div class="col-md-6 d-flex justify-content-center gap-1"></div>
                <div class="col-md-6 d-flex justify-content-center gap-1 flex-column">
                    <div class="row d-flex">
                        <div class="col-md-6">
                            <p class="form-label">Sub Total</p>
                        </div>
                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                            <p class="form-label subTotalText">0.00</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="gst">GST %</label>
                        </div>
                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                            <td><input id="gst" type="number" name="gst" class="form-control gst text-center w-50" value="0" min="0" max="28" placeholder="GST"></td>
                        </div>
                    </div>
                    <div class="row d-flex">
                        <div class="col-md-6">
                            <label for="otherCharges" class="form-label">Other Charges</label>
                        </div>
                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                            <input type="number" id="otherCharges" name="otherCharges" class="form-control otherCharges text-center w-50" value="0"></label>
                        </div>
                    </div>
                    <div class="row d-flex">
                        <div class="col-md-6">
                            <label for="discount" class="form-label">Discount %</label>
                        </div>
                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                            <input type="number" id="discount" name="discount" class="form-control discount text-center w-50" value="0"></label>
                        </div>
                    </div>
                    <hr/>
                    <div class="row d-flex">
                        <div class="col-md-6">
                            <p class="form-label h5">Total Amount (Rs.)</p>
                        </div>
                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                            <p class="form-label h5 totalAmountText">0.00</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-3 d-flex justify-content-start">
                <div class="col-md-12 d-flex justify-content-start gap-1">
                    <input type="submit" class="btn btn-success" value="Save">
                    <input type="submit" class="btn btn-primary" value="Save as Draft">
                    <input type="reset" class="btn btn-info" value="Save and Print">
                    <input type="submit" class="btn btn-secondary" value="Cancel">
                </div>
            </div>
            <input type="hidden" name="products" id="products">
            <input type="hidden" name="totalAmount" id="totalAmount">
            <input type="hidden" name="subTotal" id="subTotal">
        </form>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const allProducts = <%- JSON.stringify(products) %>;
        const selectProductInput = document.getElementById("selectProduct");
        const productGrid = document.getElementById("productGrid");
        const listbox = document.getElementById("product-listbox");
        const productsInput = document.getElementById("products");
        let totalAmountInput = document.getElementById("totalAmount");
        const subTotalInput = document.getElementById("subTotal");
        let subTotalText = document.querySelector('.subTotalText');
        let totalAmountText = document.querySelector('.totalAmountText')

        selectProductInput.addEventListener("input", function() {
            const value = this.value.toLowerCase();
            selectProductInput.innerHTML = '';
            if(value.length === 0) {
                listbox.innerHTML = '';
                return;
            }
            const suggestions = allProducts.filter(product => product.name.toLowerCase().includes(value));
            showSuggestions(suggestions);
        });

        function showSuggestions(suggestions) {
            suggestions.forEach(product => {
                const itemDiv = document.createElement("div");
                itemDiv.classList.add("list-item");
                itemDiv.textContent = product.name;
                itemDiv.addEventListener("click", function() {
                    addProductToGrid(product);
                    selectProductInput.value = "";
                    listbox.innerHTML = "";
                    listbox.remove();
                });
                listbox.appendChild(itemDiv);
            });
            clearSuggestions();
            selectProductInput.parentNode.appendChild(listbox);

            document.addEventListener("click", function(event) {
                if (!selectProductInput.contains(event.target)) {
                    listbox.innerHTML = ''; // Close suggestions
                    selectProductInput.value = "";
                }
            });
        }

        function clearSuggestions() {
            const existingSuggestions = document.querySelector("#product-listbox");
            if (existingSuggestions) {
                existingSuggestions.remove();
            }
        }

        function addProductToGrid(product) {
            let rowId = productGrid.rows.length + 1;
            const productRow = `
                <tr>
                    <td>${rowId}</td>
                    <td class="productName"><a href="/products/details/${product._id}" data-product-id="${product._id}">${product.name}</a></td>
                    <td><input type="number" name="quantity" class="form-control text-end quantity" value="1" min="1"></td>
                    <td><input type="number" name="salePrice" class="form-control text-end salePrice" value="${product.salePrice}" readonly></td>
                    <td><input type="number" name="amount" class="form-control text-end amount" value="0" min="0" readonly></td></td>
                    <td><button type="button" class="btn btn-outline-danger remove-product" aria-label="Remove ${product.name}"><i class="fa fa-x"></i></button></td>
                </tr>
            `;
            productGrid.insertAdjacentHTML("beforeend", productRow);
            attachEventListenersToRow(productGrid.lastElementChild);
            calculateSubtotal(productGrid.lastElementChild);
            updateHiddenFields();
        }

        function attachEventListenersToRow(row) {
            const quantityInput = row.querySelector('.quantity');
            const gstInput = document.querySelector('.gst');
            const sgstInput = row.querySelector('.sgst');
            const discountInput = document.querySelector('.discount');
            const otherChargesInput = document.querySelector(".otherCharges");

            quantityInput.addEventListener('input', () => {
                calculateSubtotal(row);
                updateHiddenFields();
            });
            gstInput.addEventListener('input', () => {
                calculateSubtotal(row);
                updateHiddenFields();
            });
            // sgstInput.addEventListener('input', () => {
            //     calculateSubtotal(row);
            //     updateHiddenFields();
            // });
            discountInput.addEventListener('input', () => {
                calculateSubtotal(row);
                updateHiddenFields();
            });
            otherChargesInput.addEventListener('input', () => {
                calculateSubtotal(row);
                updateHiddenFields();
            });
        }

        function calculateSubtotal(row) {
            const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
            const salePrice = parseFloat(row.querySelector('.salePrice').value) || 0;
            const itemTotal = quantity * salePrice;

            row.querySelector('.amount').value = itemTotal.toFixed(2);
        }

        function updateHiddenFields() {
            const rows = productGrid.querySelectorAll('tr');
            const products = [];
            let subTotal = 0;
            let totalAmount = 0;
            const gst = parseFloat(document.querySelector('.gst').value) || 0;
            const discount = parseFloat(document.querySelector('.discount').value) || 0;
            const otherCharges = parseFloat(document.querySelector('.otherCharges').value) || 0;

            rows.forEach(row => {
                const productId = row.querySelector('.productName a').getAttribute('data-product-id');
                const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
                const salePrice = parseFloat(row.querySelector('.salePrice').value) || 0;
                const amount = parseFloat(row.querySelector('.amount').value) || 0;

                const subtotal = quantity * (salePrice);

                products.push({
                    productId,
                    quantity,
                    salePrice,
                    amount: subtotal
                });
                subTotal += subtotal;
                
            });
            
            const gstTotal = (gst / 100) * subTotal;
            const total = subTotal /** (1 - discount / 100)*/;
            
            const grossTotal = total + gstTotal + otherCharges;
            totalAmount = grossTotal * (1 - discount / 100);

            productsInput.value = JSON.stringify(products);
            subTotalInput.value = subTotal.toFixed(2);
            totalAmountInput.value = totalAmount.toFixed(2);
            subTotalText.innerHTML = subTotal.toFixed(2);
            totalAmountText.innerHTML = totalAmount.toFixed(2);
        }

        document.addEventListener("click", function(event) {
            if (!selectProductInput.contains(event.target)) {
                clearSuggestions();
            }
        });

        productGrid.addEventListener("click", function(event) {
            if (event.target.classList.contains("remove-product")) {
                event.target.closest("tr").remove();
            }
        });
    });
</script>