<div class="modal fade" id="invoiceEditModal" tabindex="-1" aria-labelledby="invoiceModalLabel" aria-hidden="true">  
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="invoiceModalLabel">View Invoice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="container d-flex flex-column justify-content-center px-5">
                    <div class="row mb-2">
                        <form class="newProduct needs-validation" method="post" action="/sales" novalidate>
                            <div class="row mb-2 d-flex justify-content-start">
                                <div class="col-md-4">
                                    <label for="invoiceNumber" class="form-label">Invoice Number</label>
                                    <input id="invoiceNumber" type="text" name="invoiceNumber" class="form-control disabled read-only" value="" placeholder="Invoice Number" readonly>
                                </div>
                                <div class="col-md-4">
                                    <label for="salesman" class="form-label">Salesman</label>
                                    <select id="salesman" class="form-select" aria-label="Salesman" name="salesman" required>
                                        <option selected value="">Select</option>
                                    </select>
                                    <div class="invalid-feedback">Please Select Salesman</div>
                                    <div class="valid-feedback">Looks Good!</div>
                                </div>
                                <div class="col-md-4">
                                    <label for="invoiceDate" class="form-label">Invoice Date</label>
                                    <input id="invoiceDate" type="date" name="invoiceDate" class="form-control disabled" placeholder="Invoice Date" value="<%= new Date().toISOString().split("T")[0] %>" max="<%= new Date().toISOString().split("T")[0] %>" required>
                                </div>
                            </div>
                            <div class="row mb-2 mt-2 d-flex justify-content-start" id="customerDetails" role="group" aria-label="Customer Details">
                                <div class="col-md-8 mb-1">
                                    <label for="customerName" class="form-label">Customer Name *</label>
                                    <input id="customerName" type="Text" name="customerName" class="form-control" placeholder="CustomerName" required>
                                    <div class="invalid-feedback">Customer Name cannot be blank</div>
                                    <div class="valid-feedback">Looks Good!</div>
                                </div>
                                <div class="col-md-4 mb-1">
                                    <label for="mobile" class="form-label">Mobile</label>
                                    <input id="mobile" type="text" name="mobile" class="form-control" placeholder="Mobile" maxlength="10">
                                </div>
                                <div class="col-md-6 mb-1">
                                    <label for="email" class="form-label">Email</label>
                                    <input id="email" type="email" name="email" class="form-control" placeholder="Email" autocomplete="email">
                                </div>
                                <div class="col-md-6 mb-1">
                                    <label for="address" class="form-label">Address</label>
                                    <input id="address" type="Text" name="address" class="form-control" placeholder="Address" autocomplete="address-line1">
                                </div>
                            </div>
                            <div class="row mb-2 d-flex justify-content-start" id="paymentDetails" role="group" aria-label="Payment Details">
                                <div class="col-md-6 mb-2">
                                    <label for="paymentStatus" class="form-label">Payment Status</label>
                                    <select id="paymentStatus" class="form-select" aria-label="Invoice Type" name="paymentStatus" required>
                                    </select>
                                    <div class="invalid-feedback">Please Select Invoice Type</div>
                                    <div class="valid-feedback">Looks Good!</div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="dueDate" class="form-label">Due Date</label>
                                    <input id="dueDate" type="date" name="dueDate" class="form-control" placeholder="Due Date" min=<%= new Date().toISOString().split("T")[0] %> required>
                                    <div class="invalid-feedback">Due Date cannot be blank</div>
                                    <div class="valid-feedback">Looks Good!</div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label for="paymentMode" class="form-label">Payment Method</label>
                                    <select id="paymentMode" class="form-select" aria-label="Payment Mode" name="paymentMode" required>
                                    </select>
                                    <div class="invalid-feedback">Please Select Payment Mode</div>
                                    <div class="valid-feedback">Looks Good!</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="balance" class="form-label">Balance</label>
                                    <input id="balance" type="Text" name="balance" class="form-control disabled" placeholder="Balance" readonly>
                                </div>
                            </div>
                            <div class="row mb-1 mt-4 d-flex justify-content-start">
                                <div class="col-md-12 mb-2">
                                    <label for="selectProduct" class="form-label">Select Product</label>
                                    <input id="selectProduct" type="text" class="form-control" placeholder="Type to search product" required>
                                    <div id="product-listbox" class="autocomplete-products"></div>
                                    <div class="invalid-feedback">Please Select Product</div>
                                    <div class="valid-feedback">Looks Good!</div>
                                </div>
                            </div>
                            <div class="row mb-1 mt-2 d-flex justify-content-start">
                                <div class="col-md-12 p-3 rounded border">
                                    <table class="table table-hover border m-0 m-auto items-table">
                                        <thead>
                                            <tr>
                                              <th scope="col" class="text-center align-middle">#</th>
                                              <th scope="col" class="text-center align-middle" style="width: 200px">Product Name</th>
                                              <th scope="col" class="text-center align-middle">Qty</th>
                                              <th scope="col" class="text-center align-middle">Rate</th>
                                              <th scope="col" class="text-center align-middle">Amount</th>
                                            </tr>
                                          </thead>
                                          <tbody id="productGrid">
                                          </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row mt-3 d-flex">
                                <div class="col-md-6 d-flex justify-content-center gap-1"></div>
                                <div class="col-md-6 d-flex justify-content-center gap-1 flex-column">
                                    <div class="row d-flex">
                                        <div class="col-md-6">
                                            <p class="form-label">Sub Total</p>
                                        </div>
                                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                                            <p class="form-label subTotalText" id="subTotalText">0.00</p>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="gst">GST %</label>
                                        </div>
                                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                                            <td><input id="gst" type="number" name="gst" class="form-control gst text-center w-50" value="0" min="0" max="28" placeholder="GST"></td>
                                        </div>
                                    </div>
                                    <div class="row d-flex">
                                        <div class="col-md-6">
                                            <label for="otherCharges" class="form-label">Other Charges</label>
                                        </div>
                                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                                            <input type="number" id="otherCharges" name="otherCharges" class="form-control otherCharges text-center w-50" value="0"></label>
                                        </div>
                                    </div>
                                    <div class="row d-flex">
                                        <div class="col-md-6">
                                            <label for="discount" class="form-label">Discount %</label>
                                        </div>
                                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                                            <input type="number" id="discount" name="discount" class="form-control discount text-center w-50" value="0"></label>
                                        </div>
                                    </div>
                                    <hr/>
                                    <div class="row d-flex">
                                        <div class="col-md-6">
                                            <p class="form-label h5">Total Amount (Rs.)</p>
                                        </div>
                                        <div class="col-md-6 justify-content-center align-items-center d-flex">
                                            <p class="form-label h5 totalAmountText">0.00</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" name="products" id="products">
                            <input type="hidden" name="totalAmount" id="totalAmount">
                            <input type="hidden" name="subTotal" id="subTotal">
                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-success view-modal-print" id="view-modal-print" >Print</button>
                    <button type="button" class="btn btn-outline-success view-modal-edit" id="view-modal-edit" >Edit</button>
                    <button type="button" class="btn btn-outline-success view-modal-delete" id="view-modal-delete">Delete</button>     
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>